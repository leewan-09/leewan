---
import { SITE } from "@/lib/content";
---

<header class="pointer-events-none fixed inset-x-0 top-4 z-20 xl:top-6">
  <div class="mx-auto max-w-[1440px] px-(--margin)">
    <nav
      aria-label="Main"
      class="nav pointer-events-auto inline-flex items-center gap-3 rounded-full border border-line py-2 pr-2 pl-4 text-sm/5 min-[350px]:gap-5 min-[350px]:pl-5 sm:gap-8 sm:pl-6"
    >
      <a href="#top" class="font-medium text-ink">
        {SITE.name}
      </a>
      <a href="#work" class="text-ink-2 transition-colors hover:text-ink">
        Work
      </a>
      <a href="#about" class="text-ink-2 transition-colors hover:text-ink">
        About
      </a>
      <a
        href="#contact"
        class="rounded-full border border-line-strong px-4 py-2 font-medium text-ink transition-colors hover:bg-white/10"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    background: rgb(20 20 22 / 0.92);
  }

  @supports (backdrop-filter: blur(1px)) {
    .nav {
      background: rgb(20 20 22 / 0.6);
      backdrop-filter: blur(24px);
    }
  }
</style>
